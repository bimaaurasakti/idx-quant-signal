# Kredensial Supabase -- SAMA seperti .streamlit/secrets.toml versi lama
# (dibaca oleh supabase_client.py, TIDAK diubah mekanismenya sama sekali)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.....

# Konfigurasi khusus lapisan API (baru)
ALLOWED_ORIGINS=http://localhost:3000
CACHE_TTL_SECONDS=600

# SUPABASE_SERVICE_ROLE_KEY TIDAK PERNAH ditaruh di sini -- tetap eksklusif
# GitHub Actions secret milik worker_fetch_and_update.py.
