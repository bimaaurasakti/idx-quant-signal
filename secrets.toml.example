# Rename file ini menjadi "secrets.toml" (hapus ".example") dan isi dengan
# kredensial Supabase Anda.
#
# JANGAN commit file secrets.toml yang sudah terisi ke Git — sudah masuk
# .gitignore, tapi tetap hati-hati.
#
# PENTING: app.py (dashboard publik) HANYA butuh ANON KEY, bukan service
# role key. Anon key aman dipakai di sini karena schema.sql sudah membatasi
# role anon hanya bisa SELECT (baca), tidak bisa menulis. Service role key
# HANYA untuk GitHub Actions secret (worker), JANGAN PERNAH taruh di sini.
#
# Ambil dari: Supabase Dashboard > Project Settings > API

SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....."
